<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EDIT USER</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <!DOCTYPE html>
    <html>
      <body>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/create">CREATE USER</a></li>
        </ul>

        <div class="form-add">
          <form action="/edit-user" method="post">
            <fieldset>
              <legend>Form edit user</legend>

              <div class="input-group">
                <input type="hidden" name="id" value="<%= user.id%>" />
                <label for="">Email: </label>
                <input
                  type="text"
                  name="email"
                  id="emailId"
                  value="<%= user.email %>"
                />
              </div>
              <div class="input-group">
                <label for="">Name: </label>
                <input
                  type="text"
                  name="name"
                  id="nameId"
                  value="<%= user.name %>"
                />
              </div>
              <div class="input-group">
                <label for="">City: </label>
                <input
                  type="text"
                  name="city"
                  id="cityId"
                  value="<%= user.city %>"
                />
              </div>
              <div class="button">
                <button>SAVE</button>
              </div>
            </fieldset>
          </form>
        </div>
      </body>
    </html>
  </body>
</html>
